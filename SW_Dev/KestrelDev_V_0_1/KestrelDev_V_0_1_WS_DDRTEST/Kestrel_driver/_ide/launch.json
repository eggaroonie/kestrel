{
	"version": "0.2.0",
	"configurations": [
		{
			"type": "tcf-debug",
			"request": "launch",
			"name": "Kesterl_driver_app_hw_1",
			"debugType": "baremetal-zu",
			"attachToRunningTargetOptions": {
				"targetSetupMode": "standalone",
				"executeScript": true,
				"scriptPath": ""
			},
			"autoAttachProcessChildren": false,
			"target": {
				"targetConnectionId": "Local",
				"peersIniPath": "../../_ide/.peers.ini",
				"context": "ZUPlus"
			},
			"pathMap": [],
			"targetSetup": {
				"resetSystem": true,
				"programDevice": true,
				"enableRPUSplitMode": false,
				"resetAPU": false,
				"resetRPU": false,
				"bitstreamFile": "${workspaceFolder}/DDR_test/hw/kestrelv0_1.bit",
				"zuInitialization": {
					"isFsbl": true,
					"usingFSBL": {
						"initWithFSBL": true,
						"fsblFile": "${workspaceFolder}/DDR_test/export/DDR_test/sw/boot/fsbl.elf",
						"fsblExitSymbol": "XFsbl_Exit"
					},
					"usingPsuInit": {
						"runPsuInit": true,
						"plPowerup": false,
						"psuInitTclFile": "${workspaceFolder}/Kesterl_driver/_ide/psinit/psu_init.tcl"
					}
				},
				"zuTraceOptions": {
					"isSelected": false,
					"scratchAddress": "0x60000",
					"scratchSize": "0x60000",
					"traceOutputPath": ""
				},
				"downloadElf": [
					{
						"core": "psu_cortexa53_0",
						"resetProcessor": true,
						"elfFile": "${workspaceFolder}/Kesterl_driver/build/Kesterl_driver.elf",
						"stopAtEntry": false
					}
				],
				"crossTriggerBreakpoints": {
					"isSelected": false,
					"breakpoints": []
				}
			},
			"internalConsoleOptions": "openOnSessionStart"
		}
	]
}